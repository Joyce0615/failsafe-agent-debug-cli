{
  "name": "failsafe",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "failsafe": "./dist/index.js",
    "failsafe-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "ci/action.yml",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun src/cli/index.ts",
    "mcp": "bun src/mcp/server.ts",
    "build": "bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "package": "bun scripts/clean.ts && bun scripts/package.ts",
    "test": "bun test tests/",
    "setup:fixtures": "bun scripts/setup-fixtures.ts",
    "bench": "bun scripts/bench.ts --check",
    "test:e2e": "bun scripts/setup-fixtures.ts && bun test tests/e2e/",
    "lint": "bunx biome check src/",
    "format": "bunx biome format --write src/",
    "typecheck": "bunx tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run lint && bun test tests/ && bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "commander": "^13.0.0",
    "nanoid": "^5.1.0",
    "yaml": "^2.8.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "latest",
    "@vscode/debugprotocol": "^1.68.0",
    "typescript": "^5.7.0"
  }
}
