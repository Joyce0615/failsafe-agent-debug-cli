node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Failsafe runtime artifacts.
# This is the tool's own repo, so we never commit a .failsafe/ workspace
# (generated by `failsafe init` during testing). Consuming projects manage
# their own .failsafe/config.json and .failsafe/rules.yaml separately.
.failsafe/

# Python cache artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Fixture project artifacts (not part of the repo)
tests/e2e/node_project/node_modules/
tests/e2e/pytest_project/.pytest_cache/

# Logs
*.log

# Benchmark corpora and sweep results (item 39) — never committed or packaged.
bench-data/
bench-results/
*.bench.jsonl
